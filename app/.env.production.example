# ===== ENTORNO DE PRODUCCIÓN (DigitalOcean + Azure) =====

# --- App ---
APP_ENV=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:25060/grc?sslmode=require

# --- Proveedor de IA (producción: Azure OpenAI) ---
AI_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Alternativa SiliconFlow (si no usas Azure) ---
# AI_PROVIDER=siliconflow
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
# CHAT_MODEL=deepseek-ai/DeepSeek-V3
# SF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- Storage (DigitalOcean Spaces) ---
STORAGE_BACKEND=spaces
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=iso-grc-evidence
SPACES_REGION=nyc3

# --- Rate limiting (ajustes de producción) ---
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_GLOBAL=100/minute